/* Smooth scroll for anchor links */
document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener('click', e=>{
    const id = a.getAttribute('href').slice(1);
    const el = document.getElementById(id);
    if(el){ e.preventDefault(); el.scrollIntoView({behavior:'smooth', block:'start'}); }
  });
});

/* Open/closed badge (Mon–Sat 08:30–18:00; Sun closed) */
(function(){
  const openBadge = document.getElementById('open-badge');
  if(!openBadge) return;
  const now = new Date();
  const day = now.getDay(); // 0 Sun ... 6 Sat
  const hour = now.getHours() + now.getMinutes()/60;
  let open = false;
  if(day >= 1 && day <= 6){ // Mon-Sat
    open = hour >= 8.5 && hour <= 18;
  }
  openBadge.textContent = open ? 'ABERTO AGORA' : 'FECHADO NO MOMENTO';
  openBadge.style.color = open ? '#1dd1a1' : '#ff6b6b';
})();

/* Preenche ano no rodapé */
document.getElementById('year').textContent = new Date().getFullYear();
